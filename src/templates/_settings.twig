{# @var plugin \heavymetalavo\craftaialttext\AiAltText #}
{# @var settings \heavymetalavo\craftaialttext\models\Settings #}
{% import '_includes/forms.twig' as forms %}

<h2>Instructions</h2>

<p>Lots of info in <a target="_blank" href="https://github.com/heavymetalavo/craft-aialttext">the plugin docs</a>, but a short summary;</p>
<ol>
    <li>Check the plugin settings are suitable for your project (and your API key is added)</li>
    <li>Ensure your volumes have <a href="https://docs.craftcms.com/api/v5/craft-fieldlayoutelements-assets-altfield.html#altfield" target="_blank">the native alt field</a> assigned to the field layout</li>
    <li>Ensure your templates are updated to use the <code>alt</code> field, you could consider a fallback <code>asset.alt ?: asset.title</code> if that what was used before</li>
    <li>Then generate some AI Alt text by performing one of the following actions:
        <ol>
            <li>Triggering a bulk action in the <a href="{{ cpUrl('utilities/ai-alt-text-bulk-actions') }}">bulk actions utility</a></li>
            <li>For individual or a group of specific assets find them in the <strong>Assets</strong> manager section, clicking the checkbox on a row, clicking the cog icon to reveal the Element actions menu and select <strong>Generate AI Alt Text</strong></li>
            <li>When viewing a single asset's page, open the action menu and select <strong>Generate AI Alt Text</strong></li>
            <li>Upload a new asset (if the upload setting is enabled)</li>
        </ol>
    </li>
    <li>Alt text for a single asset, selected in the <strong>Assets</strong> manager or on its own page, is generated straight away. Multiple selected assets, the bulk actions utility, new uploads, and the other sites when <strong>Save translated results for each site</strong> is enabled are queued as jobs instead</li>
</ol>


<hr />


<h2 id="settings">Settings</h2>

{% set providerOptions = [
    { label: 'Anthropic', value: 'anthropic' },
    { label: 'OpenAI', value: 'openai' },
    { label: 'Langdock', value: 'langdock' }
] %}
{% set providerValues = providerOptions|map(o => o.value) %}

{% set resolvedProvider = parseEnv(settings.aiProvider) %}
{% set hiddenProviders = resolvedProvider in providerValues
    ? providerValues|filter(v => v != resolvedProvider)
    : [] %}

{% set langdockFormats = ['anthropic', 'openai'] %}
{% set resolvedLangdockFormat = parseEnv(settings.langdockApiFormat) %}
{% set hiddenLangdockFormats = resolvedLangdockFormat in langdockFormats
    ? langdockFormats|filter(v => v != resolvedLangdockFormat)
    : [] %}

{{ forms.selectizeField({
    label: "AI Provider"|t("ai-alt-text"),
    instructions: "Choose which AI service to use for generating alt text. Only the chosen provider's settings are shown below. If you choose an environment variable, save and reload to show its provider's settings."|t("ai-alt-text"),
    id: "aiProvider",
    name: "aiProvider",
    options: providerOptions,
    includeEnvVars: true,
    allowedEnvValues: null,
    value: settings.aiProvider,
    errors: settings.getErrors("aiProvider"),
    toggle: true,
    targetPrefix: '#provider-',
}) }}


<div id="provider-anthropic" class="{{ 'anthropic' in hiddenProviders ? 'hidden' }}">
    <hr />

    <h3>Anthropic Settings</h3>

    {{ forms.autosuggestField({
        label: "Anthropic API Key"|t("ai-alt-text"),
        instructions: "The API key from your [Anthropic Console account](https://console.anthropic.com/)"|t("ai-alt-text"),
        id: "anthropicApiKey",
        name: "anthropicApiKey",
        placeholder: '$ANTHROPIC_API_KEY',
        suggestEnvVars: true,
        value: settings.anthropicApiKey,
        errors: settings.getErrors("anthropicApiKey"),
    }) }}

    {{ forms.autosuggestField({
        label: 'Anthropic Model'|t('ai-alt-text'),
        id: 'anthropicModel',
        name: 'anthropicModel',
        instructions: "The Anthropic model to use. [See available models list](https://docs.anthropic.com/en/docs/about-claude/models). E.g., `claude-haiku-4-5`."|t("ai-alt-text"),
        value: settings.anthropicModel,
        placeholder: 'claude-haiku-4-5',
        errors: settings.getErrors('anthropicModel'),
        suggestEnvVars: true,
    }) }}

    {{ forms.selectizeField({
        label: 'Anthropic Image Detail Level'|t('ai-alt-text'),
        id: 'anthropicImageDetailLevel',
        name: 'anthropicImageDetailLevel',
        instructions: "Pre-scale the image to reduce [token cost and latency](https://platform.claude.com/docs/en/build-with-claude/vision#evaluate-image-size)."|t("ai-alt-text"),
        options: [
            { label: 'Low (500px x 500px)', value: 'low' },
            { label: 'Medium (1000px x 1000px)', value: 'medium' },
            { label: 'High (1568px x 1568px)', value: 'high' }
        ],
        includeEnvVars: true,
        allowedEnvValues: null,
        value: settings.anthropicImageDetailLevel,
        errors: settings.getErrors('anthropicImageDetailLevel')
    }) }}
</div>


<div id="provider-openai" class="{{ 'openai' in hiddenProviders ? 'hidden' }}">
    <hr />

    <h3>OpenAI Settings</h3>

    {{ forms.autosuggestField({
        label: "OpenAI API Key"|t("ai-alt-text"),
        instructions: "The API key from your Open AI account"|t("ai-alt-text"),
        id: "openAiApiKey",
        name: "openAiApiKey",
        placeholder: '$OPENAI_API_KEY',
        suggestEnvVars: true,
        value: settings.openAiApiKey,
        errors: settings.getErrors("openAiApiKey"),
    }) }}

    {{ forms.autosuggestField({
        label: 'OpenAI Model'|t('ai-alt-text'),
        id: 'openAiModel',
        name: 'openAiModel',
        instructions: "The OpenAI model used to generate the response. To find out which models are capable of vision OpenAI suggest to look [on the models page](https://platform.openai.com/docs/models) E.g., `gpt-6-luna`."|t("ai-alt-text"),
        value: settings.openAiModel,
        placeholder: 'gpt-6-luna',
        errors: settings.getErrors('openAiModel'),
        suggestEnvVars: true,
    }) }}

    {{ forms.selectizeField({
        label: 'OpenAI Image Detail Level'|t('ai-alt-text'),
        id: 'openAiImageInputDetailLevel',
        name: 'openAiImageInputDetailLevel',
        instructions: "Controls the [detail level](https://developers.openai.com/api/docs/guides/images-vision#choose-an-image-detail-level) OpenAI uses to process the image. Large images are also pre-scaled to stay within API limits. `low` is fastest and cheapest."|t("ai-alt-text"),
        options: [
            { label: 'Low - Fast, low-cost (512px x 512px)', value: 'low' },
            { label: 'High - Standard high-fidelity understanding', value: 'high' },
            { label: 'Original - Large, dense, spatially sensitive images (gpt-5.4+)', value: 'original' },
            { label: 'Auto - Let the model choose', value: 'auto' }
        ],
        includeEnvVars: true,
        allowedEnvValues: null,
        value: settings.openAiImageInputDetailLevel,
        errors: settings.getErrors('openAiImageInputDetailLevel')
    }) }}

    {{ forms.selectizeField({
        label: 'OpenAI Reasoning Effort'|t('ai-alt-text'),
        id: 'openAiReasoningEffort',
        name: 'openAiReasoningEffort',
        instructions: "Controls the [reasoning effort](https://developers.openai.com/api/docs/guides/reasoning#reasoning-effort) value when using models that support reasoning like `o*` (e.g., `o1`) and `gpt-5*`. Lower effort favors speed and lower token usage. Which values a model accepts depends on the model, so check the provider's documentation if a value is rejected."|t("ai-alt-text"),
        options: [
            { label: 'None', value: 'none' },
            { label: 'Minimal', value: 'minimal' },
            { label: 'Low', value: 'low' },
            { label: 'Medium', value: 'medium' },
            { label: 'High', value: 'high' },
            { label: 'Extra High', value: 'xhigh' }
        ],
        includeEnvVars: true,
        allowedEnvValues: null,
        value: settings.openAiReasoningEffort,
        errors: settings.getErrors('openAiReasoningEffort')
    }) }}
</div>


<div id="provider-langdock" class="{{ 'langdock' in hiddenProviders ? 'hidden' }}">
    <hr />

    <h3>Langdock Settings</h3>

    {{ forms.autosuggestField({
        label: "Langdock API Key"|t("ai-alt-text"),
        instructions: "An API key from your [Langdock workspace](https://docs.langdock.com/en/developer/overview/api-introduction). One key works for both API formats."|t("ai-alt-text"),
        id: "langdockApiKey",
        name: "langdockApiKey",
        placeholder: '$LANGDOCK_API_KEY',
        suggestEnvVars: true,
        value: settings.langdockApiKey,
        errors: settings.getErrors("langdockApiKey"),
    }) }}

    {{ forms.selectizeField({
        label: 'Langdock API Format'|t('ai-alt-text'),
        id: 'langdockApiFormat',
        name: 'langdockApiFormat',
        instructions: "Which of Langdock's compatible APIs to send requests to. Pick the one that matches the model below: `Anthropic` for Claude models, `OpenAI` for GPT models. If you choose an environment variable, save and reload to show the matching settings."|t("ai-alt-text"),
        options: [
            { label: 'Anthropic (Claude models)', value: 'anthropic' },
            { label: 'OpenAI (GPT models)', value: 'openai' }
        ],
        includeEnvVars: true,
        allowedEnvValues: null,
        value: settings.langdockApiFormat,
        errors: settings.getErrors('langdockApiFormat'),
        toggle: true,
        targetPrefix: '#langdock-format-',
    }) }}

    {{ forms.autosuggestField({
        label: 'Langdock Model'|t('ai-alt-text'),
        id: 'langdockModel',
        name: 'langdockModel',
        instructions: "The model to use, as named in Langdock. It must have vision capabilities and match the API format above. [See how to list the models in your workspace](https://docs.langdock.com/en/developer/completion-api/anthropic)."|t("ai-alt-text"),
        value: settings.langdockModel,
        errors: settings.getErrors('langdockModel'),
        suggestEnvVars: true,
    }) }}

    {{ forms.selectizeField({
        label: 'Langdock Region'|t('ai-alt-text'),
        id: 'langdockRegion',
        name: 'langdockRegion',
        instructions: "The region your Langdock workspace's data is processed in."|t("ai-alt-text"),
        options: [
            { label: 'EU', value: 'eu' },
            { label: 'US', value: 'us' }
        ],
        includeEnvVars: true,
        allowedEnvValues: null,
        value: settings.langdockRegion,
        errors: settings.getErrors('langdockRegion')
    }) }}

    <div id="langdock-format-openai" class="{{ 'openai' in hiddenLangdockFormats ? 'hidden' }}">
        {{ forms.selectizeField({
            label: 'Langdock Image Detail Level'|t('ai-alt-text'),
            id: 'langdockImageInputDetailLevel',
            name: 'langdockImageInputDetailLevel',
            instructions: "Controls the [detail level](https://developers.openai.com/api/docs/guides/images-vision#choose-an-image-detail-level) used to process the image. Large images are also pre-scaled to stay within API limits. `low` is fastest and cheapest."|t("ai-alt-text"),
            options: [
                { label: 'Low - Fast, low-cost (512px x 512px)', value: 'low' },
                { label: 'High - Standard high-fidelity understanding', value: 'high' },
                { label: 'Auto - Let the model choose', value: 'auto' }
            ],
            includeEnvVars: true,
            allowedEnvValues: null,
            value: settings.langdockImageInputDetailLevel,
            errors: settings.getErrors('langdockImageInputDetailLevel')
        }) }}

        {{ forms.selectizeField({
            label: 'Langdock Reasoning Effort'|t('ai-alt-text'),
            id: 'langdockReasoningEffort',
            name: 'langdockReasoningEffort',
            instructions: "Controls the [reasoning effort](https://developers.openai.com/api/docs/guides/reasoning#reasoning-effort) value when using models that support reasoning like `o*` (e.g., `o1`) and `gpt-5*`. Lower effort favors speed and lower token usage. Which values a model accepts depends on the model, so check the provider's documentation if a value is rejected."|t("ai-alt-text"),
            options: [
                { label: 'None', value: 'none' },
                { label: 'Minimal', value: 'minimal' },
                { label: 'Low', value: 'low' },
                { label: 'Medium', value: 'medium' },
                { label: 'High', value: 'high' },
                { label: 'Extra High', value: 'xhigh' }
            ],
            includeEnvVars: true,
            allowedEnvValues: null,
            value: settings.langdockReasoningEffort,
            errors: settings.getErrors('langdockReasoningEffort')
        }) }}
    </div>
</div>


<hr />


{{ forms.textareaField({
    label: 'Prompt'|t('ai-alt-text'),
    id: 'prompt',
    name: 'prompt',
    rows: 8,
    instructions: "Sent to the AI provider as the system / instruction message. The field supports simple Asset Model and Site Model property values using `{asset.property}` and `{site.property}`. Consider `{site.languageName}` for the site's language display name (e.g. `English (United Kingdom)`) which can help with translations on non-english sites. Checkout [the readme](https://github.com/heavymetalavo/craft-aialttext?tab=readme-ov-file#-default-prompt) for the most up to date suggestion prompt template."|t("ai-alt-text"),
    value: settings.prompt,
    placeholder: "Describe the image provided (roughly 150 characters). The output MUST be suitable for use directly as an HTML alt attribute value. Consider transparency within the image if supported by the file type, e.g. don\'t suggest it has a dark background if it is transparent. When describing a person do not assume their gender. Do not add a prefix of any kind (e.g. \"#\", \"alt text:\", \"An image of\", \"A photo of\"). Do not wrap the output in quotes. Output in the language: {site.languageName} (BCP 47: {site.language})",
    errors: settings.getErrors('prompt'),
}) }}

{{ forms.lightswitchField({
    label: 'Propagate'|t('ai-alt-text'),
    id: 'propagate',
    name: 'propagate',
    instructions: "Whether the asset should be saved across all of its supported sites, if enabled it could save the same initial alt text value across all sites."|t("ai-alt-text"),
    on: settings.propagate,
    errors: settings.getErrors('propagate'),
}) }}

{{ forms.lightswitchField({
    label: 'Generate for new image assets (on upload or file replacement)'|t('ai-alt-text'),
    id: 'generateForNewAssets',
    name: 'generateForNewAssets',
    instructions: "If enabled, the plugin will automatically generate alt text when an image asset is created (on upload) or its file is replaced. On replacement, the alt text for the site the replacement was made in is overwritten, since it describes the old image; other sites keep their existing alt text unless Save translated results for each site is enabled."|t("ai-alt-text"),
    on: settings.generateForNewAssets,
    errors: settings.getErrors('generateForNewAssets'),
}) }}

{{ forms.lightswitchField({
    label: 'Process SVGs'|t('ai-alt-text'),
    id: 'processSvgs',
    name: 'processSvgs',
    instructions: "Attempt to generate alt text for SVG files when they are uploaded or batched processed. This requires Craft's global `transformSvgs` setting to be enabled."|t("ai-alt-text")
        ~ (craft.app.config.general.transformSvgs ? "" : "\n\n⚠️ " ~ "**Craft's `transformSvgs` setting is currently disabled, so SVGs will be skipped even with this enabled.**"|t("ai-alt-text")),
    on: settings.processSvgs,
    errors: settings.getErrors('processSvgs'),
}) }}

{{ forms.lightswitchField({
    label: 'Save translated results for each site'|t('ai-alt-text'),
    id: 'saveTranslatedResultsToEachSite',
    name: 'saveTranslatedResultsToEachSite',
    instructions: "If enabled, the plugin will queue an extra job for each site using related content e.g. where `{site.language}` is used in the prompt it will be replaced with the assigned language of the site (`en-GB` for British english, `en-US` for American english, `de` for German etc). When disabled, alt text will generate for assets on the site the control panel is currently working with only."|t("ai-alt-text"),
    on: settings.saveTranslatedResultsToEachSite,
    errors: settings.getErrors('saveTranslatedResultsToEachSite'),
}) }}




