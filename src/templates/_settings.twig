<h3>General Settings</h3>

{% set defaultPrompt = constant('DEFAULT_PROMPT', settings) %}
{{ forms.textareaField({
    label: 'Prompt'|t('ai-alt-text'),
    id: 'prompt',
    name: 'prompt',
    warning: config.prompt is defined ? configWarning('prompt'),
    rows: 5,
    instructions: "Sent to the AI provider as the system / instruction message. The field supports simple Asset Model and Site Model property values using `{asset.property}` and `{site.property}`. Consider `{site.languageName}` for the site's language display name (e.g. `English (United Kingdom)`) which can help with translations on non-english sites. Checkout [the docs](https://github.com/heavymetalavo/craft-aialttext/blob/5.x/docs/settings.md#-default-prompt) for the most up to date suggestion prompt template. **Reset to default** fills the field with the plugin's current default prompt."|t("ai-alt-text"),
    value: settings.prompt,
    placeholder: defaultPrompt,
    errors: settings.getErrors('prompt'),
}) }}

{# Replaces the prompt with the default #}
<button type="button" id="prompt-default" class="btn small" style="margin: -16px 0 24px;">{{ 'Reset to default'|t('ai-alt-text') }}</button>

{% js %}
document.getElementById({{ 'prompt-default'|namespaceInputId|json_encode|raw }}).addEventListener('click', () => {
    const prompt = document.getElementById({{ 'prompt'|namespaceInputId|json_encode|raw }});
    prompt.value = {{ defaultPrompt|json_encode|raw }};
    prompt.dispatchEvent(new Event('input', { bubbles: true }));
    prompt.focus();
});
{% endjs %}

