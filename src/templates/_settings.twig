{# @var plugin \heavymetalavo\craftaialttext\AiAltText #}
{# @var settings \heavymetalavo\craftaialttext\models\Settings #}
{% import '_includes/forms.twig' as forms %}

{# Marks a field whose setting config/ai-alt-text.php sets, as the file's value wins over the one saved here #}
{% macro configWarning(setting) -%}
    {{ 'This is being overridden by the `{setting}` setting in `config/ai-alt-text.php`.'|t('ai-alt-text', { setting: setting })|markdown(inlineOnly=true) }}
{%- endmacro %}
{% from _self import configWarning %}

<div class="ai-alt-text-instructions">
    <div class="flex">
        <a href="https://github.com/heavymetalavo/craft-aialttext#readme" target="_blank" rel="noopener" class="btn" data-icon="external">{{ 'Read the docs'|t('ai-alt-text') }}</a>
        <button
            type="button"
            class="btn ai-alt-text-instructions__toggle"
            aria-expanded="false"
            aria-controls="ai-alt-text-instructions"
            data-show-label="{{ 'Show quick start'|t('ai-alt-text') }}"
            data-hide-label="{{ 'Hide quick start'|t('ai-alt-text') }}"
        >
            <div class="inline-flex">
                <div class="cp-icon puny">{{ iconSvg('bolt') }}</div>
                <div class="label">{{ 'Show quick start'|t('ai-alt-text') }}</div>
            </div>
        </button>
        <a href="{{ cpUrl('utilities/ai-alt-text-bulk-actions') }}" class="btn go">{{ 'Go to Utilities'|t('ai-alt-text') }}</a>
    </div>

    <div id="ai-alt-text-instructions" class="ai-alt-text-instructions__body" inert>
        <div class="ai-alt-text-instructions__content">
            <div class="ai-alt-text-instructions__inner">
                <ol>
                    <li>Choose a provider and add its API key below.</li>
                    <li>Add the native <a href="https://docs.craftcms.com/api/v5/craft-fieldlayoutelements-assets-altfield.html#altfield" target="_blank">alt field</a> to your volumes' field layouts, and use it in your templates, e.g. <code>asset.alt ?: asset.title</code>.</li>
                    <li>Generate alt text:
                        <ul>
                            <li>From an Asset's action menu, on its page or on the image in an entry's Assets field: <strong>Generate AI Alt Text</strong></li>
                            <li>In the Assets manager select 1 or more assets, then the cog: <strong>Generate AI Alt Text</strong></li>
                            <li>In bulk, from the <a href="{{ cpUrl('utilities/ai-alt-text-bulk-actions') }}">bulk actions utility</a> 
                            <li>Console commands via the <a target="_blank" href="https://github.com/heavymetalavo/craft-aialttext/blob/5.x/docs/console-commands.md">command line</a>.</li>
                            <li>Automatically on upload or file replacement, if <strong>Generate for new image assets</strong> is on.</li>
                        </ul>
                    </li>
                </ol>
                <p>A single asset's alt text is generated straight away. Other methods are queued as jobs, including the other sites when <strong>Save translated results for each site</strong> is on.</p>
            </div>
        </div>
    </div>
</div>

{# Slides open by animating the grid row from 0fr to 1fr. Inert while closed, so its links can't be tabbed to #}
{% css %}
    .ai-alt-text-instructions__body {
        display: grid;
        grid-template-rows: 0fr;
        opacity: 0;
        transition: grid-template-rows 0.3s ease, opacity 0.3s ease;
    }
    .ai-alt-text-instructions__body.is-open {
        grid-template-rows: 1fr;
        opacity: 1;
    }
    .ai-alt-text-instructions__content {
        min-height: 0;
        overflow: hidden;
    }
    .ai-alt-text-instructions__inner {
        padding-top: var(--m);
    }
    .ai-alt-text-instructions__inner ul {
        list-style: disc;
        padding-inline-start: 1.5em;
    }
    @media (prefers-reduced-motion: reduce) {
        .ai-alt-text-instructions__body {
            transition: none;
        }
    }
{% endcss %}

{# Namespaced settings HTML, so find the elements by class rather than by id #}
{% js %}
    document.querySelectorAll('.ai-alt-text-instructions').forEach(function(wrapper) {
        var toggle = wrapper.querySelector('.ai-alt-text-instructions__toggle');
        var body = wrapper.querySelector('.ai-alt-text-instructions__body');
        toggle.addEventListener('click', function() {
            var show = !body.classList.contains('is-open');
            body.classList.toggle('is-open', show);
            body.inert = !show;
            toggle.setAttribute('aria-expanded', show ? 'true' : 'false');
            toggle.querySelector('.label').textContent = show ? toggle.dataset.hideLabel : toggle.dataset.showLabel;
        });
    });
{% endjs %}

<hr />


<h2 id="settings">Settings</h2>

{% set providerOptions = [
    { label: 'Anthropic', value: 'anthropic' },
    { label: 'OpenAI', value: 'openai' },
    { label: 'Langdock', value: 'langdock' },
    { label: 'OpenRouter', value: 'openrouter' }
] %}
{% set providerValues = providerOptions|map(o => o.value) %}

{% set resolvedProvider = parseEnv(settings.aiProvider) %}
{% set hiddenProviders = resolvedProvider in providerValues
    ? providerValues|filter(v => v != resolvedProvider)
    : providerValues %}

{% set langdockAuthors = ['anthropic', 'openai'] %}
{% set resolvedLangdockAuthor = parseEnv(settings.langdockModelAuthor) %}
{% set hiddenLangdockAuthors = resolvedLangdockAuthor in langdockAuthors
    ? langdockAuthors|filter(v => v != resolvedLangdockAuthor)
    : [] %}

{{ forms.selectizeField({
    label: "AI Provider"|t("ai-alt-text"),
    instructions: "Choose which AI service to use for generating alt text. Only the chosen provider's settings are shown below. If you choose an environment variable, save and reload to show its provider's settings."|t("ai-alt-text"),
    id: "aiProvider",
    name: "aiProvider",
    warning: config.aiProvider is defined ? configWarning('aiProvider'),
    required: true,
    options: [{ label: 'Choose a provider…'|t('ai-alt-text'), value: '' }]|merge(providerOptions),
    includeEnvVars: true,
    allowedEnvValues: null,
    value: settings.aiProvider,
    errors: settings.getErrors("aiProvider"),
    toggle: true,
    targetPrefix: '#provider-',
    selectizeOptions: {
        allowEmptyOption: true,
        placeholder: 'Choose a provider…'|t('ai-alt-text'),
    },
}) }}


<div id="provider-anthropic" class="{{ 'anthropic' in hiddenProviders ? 'hidden' }}">
    <hr />

    <h3>Anthropic Settings</h3>

    {{ forms.autosuggestField({
        label: "Anthropic API Key"|t("ai-alt-text"),
        instructions: "The API key from your [Anthropic Console account](https://console.anthropic.com/)"|t("ai-alt-text"),
        id: "anthropicApiKey",
        name: "anthropicApiKey",
        warning: config.anthropicApiKey is defined ? configWarning('anthropicApiKey'),
        placeholder: '$ANTHROPIC_API_KEY',
        suggestEnvVars: true,
        value: settings.anthropicApiKey,
        errors: settings.getErrors("anthropicApiKey"),
    }) }}

    {{ forms.autosuggestField({
        label: 'Anthropic Model'|t('ai-alt-text'),
        id: 'anthropicModel',
        name: 'anthropicModel',
        warning: config.anthropicModel is defined ? configWarning('anthropicModel'),
        instructions: "The Anthropic model to use. [See available models list](https://docs.anthropic.com/en/docs/about-claude/models). E.g., `claude-haiku-5-5`."|t("ai-alt-text"),
        value: settings.anthropicModel,
        placeholder: 'claude-haiku-5-5',
        errors: settings.getErrors('anthropicModel'),
        suggestEnvVars: true,
    }) }}

    {{ forms.selectizeField({
        label: 'Anthropic Image Detail Level'|t('ai-alt-text'),
        id: 'anthropicImageDetailLevel',
        name: 'anthropicImageDetailLevel',
        warning: config.anthropicImageDetailLevel is defined ? configWarning('anthropicImageDetailLevel'),
        instructions: "Pre-scale the image to reduce [token cost and latency](https://platform.claude.com/docs/en/build-with-claude/vision#evaluate-image-size)."|t("ai-alt-text"),
        options: [
            { label: 'Low (500px x 500px)', value: 'low' },
            { label: 'Medium (1000px x 1000px)', value: 'medium' },
            { label: 'High (1568px x 1568px)', value: 'high' }
        ],
        includeEnvVars: true,
        allowedEnvValues: null,
        value: settings.anthropicImageDetailLevel,
        errors: settings.getErrors('anthropicImageDetailLevel')
    }) }}
</div>


