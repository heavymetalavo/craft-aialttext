{# Coverage as a small progress ring followed by the value. Inline SVG so it needs no JS or external
   component library, and uses Craft's own CSS variables so it follows the light/dark CP theme. The
   radius is 15.9155 so the circumference is exactly 100, letting the percentage drive
   stroke-dasharray directly. The figure is real text rather than an SVG <text> node so it inherits
   the CP font, stays selectable, and is read by screen readers without help, which lets the ring
   itself be decorative (aria-hidden) instead of duplicating the value. #}
{% macro coverageRing(coverage) %}
    {%- if coverage is null -%}
        <span class="light">—</span>
    {%- else -%}
        {#- Bands broadly follow the convention used for 0-100 quality scores (as in Lighthouse):
            red below 50, amber from 50, green from 90, plus a distinct colour once coverage is
            complete. Yellow at 75 splits what would otherwise be a wide, flat amber band from
            50-89, so rising coverage reads as progress; a yellow-green here would be easy to
            mistake for the green of a complete ring. Deliberately not --warning-color, which is the
            darkest amber (#b45309) and reads as brown. Hex fallbacks keep the ring sensible if a
            Craft release drops a palette variable. -#}
        {%- if coverage >= 100 -%}
            {%- set color = 'var(--success-color, #0f766e)' -%}
        {%- elseif coverage >= 90 -%}
            {%- set color = 'var(--green-500, #22c55e)' -%}
        {%- elseif coverage >= 75 -%}
            {%- set color = 'var(--yellow-500, #eab308)' -%}
        {%- elseif coverage >= 50 -%}
            {%- set color = 'var(--amber-500, #f59e0b)' -%}
        {%- else -%}
            {%- set color = 'var(--red-500, #ef4444)' -%}
        {%- endif -%}
        <span style="display: inline-flex; align-items: center; gap: 6px; white-space: nowrap;">
            {# viewBox is 40 wide for a radius of 15.9155 plus half the 6-unit stroke either side
               (20 + 15.9155 + 3 = 38.92), so the stroke isn't clipped flat at the edges. #}
            <svg viewBox="0 0 40 40" width="16" height="16" aria-hidden="true" focusable="false" style="flex: none;">
                <circle cx="20" cy="20" r="15.9155" fill="none" stroke="var(--gray-200)" stroke-width="6"/>
                {%- if coverage > 0 %}
                <circle cx="20" cy="20" r="15.9155" fill="none" stroke="{{ color }}" stroke-width="6"
                        stroke-dasharray="{{ coverage|round(1) }} 100" stroke-linecap="round" transform="rotate(-90 20 20)"/>
                {%- endif %}
            </svg>
            {{ coverage|number_format(1) }}%
        </span>
    {%- endif -%}
{% endmacro %}

{# Alt text as a bar of the site's image assets: with alt text, missing, and excluded by the Excluded volumes and
   Excluded paths settings, which coverage doesn't count. Hovering or focusing a segment shows its numbers in a
   tooltip (see utility.js). The counts are also written under the bar. The bar is always drawn when there are image
   assets, even if every one is excluded. #}
{% macro altTextBar(with, without, excluded) %}
    {%- set total = with + without + excluded -%}
    {%- if total == 0 -%}
        <span class="light">—</span>
    {%- else -%}
        {%- set segments = [
            { label: 'With alt text'|t('ai-alt-text'), class: 'aat-with', count: with, note: null },
            { label: 'Missing'|t('ai-alt-text'), class: 'aat-missing', count: without, note: 'Use Generate missing to create it.'|t('ai-alt-text') },
            { label: 'Excluded'|t('ai-alt-text'), class: 'aat-excluded', count: excluded, note: 'Left out by the Excluded volumes and Excluded paths settings, and not counted in coverage.'|t('ai-alt-text') },
        ]|filter(segment => segment.count > 0) -%}
        <div class="aat-bar">
            <div class="aat-bar-track">
                {%- for segment in segments %}
                    {%- set share = segment.count / total * 100 -%}
                    {%- set shareText = (share > 0 and share < 1 ? '<1' : share|round|number) ~ '%' -%}
                    {%- set images = '{count, plural, =1{# image asset} other{# image assets}}'|t('ai-alt-text', { count: segment.count }) -%}
                    <span class="aat-seg {{ segment.class }}" tabindex="0" role="img" aria-label="{{ segment.label }}: {{ shareText }}, {{ images }}" style="width: {{ share }}%;">
                        <span class="aat-tip">
                            <strong><span class="aat-swatch {{ segment.class }}"></span>{{ segment.label }}</strong>
                            <span>{{ shareText }} · {{ images }}</span>
                            {%- if segment.note %}<span class="aat-tip-note">{{ segment.note }}</span>{% endif %}
                        </span>
                    </span>
                {%- endfor %}
            </div>
            <div class="light smalltext aat-counts">
                {{- "{with} with · {without} missing"|t('ai-alt-text', { with: with|number, without: without|number }) -}}
                {%- if excluded > 0 %} · {{ "{excluded} excluded"|t('ai-alt-text', { excluded: excluded|number }) }}{% endif -%}
            </div>
        </div>
    {%- endif -%}
{% endmacro %}

{% if currentUser.admin %}
<div class="flex flex-nowrap" style="margin-bottom: 24px; padding-bottom: 24px; border-bottom: 1px solid rgba(0,0,0,0.05);">
    <a href="{{ cpUrl('settings/plugins/ai-alt-text') }}" class="btn " data-icon="settings">{{ "Plugin Settings"|t('ai-alt-text') }}</a>
</div>
{% endif %}

<h2>{{ "Bulk actions"|t('ai-alt-text') }}</h2>

<p>{{ "Generate alt text for all eligible image assets, the <strong>Save translated results for each site</strong> setting will be ignored to perform the requested action."|t('ai-alt-text')|raw }}</p>

<p class="light">{{ "<strong>Image assets only</strong>. Videos, PDFs and audio aren't counted. Formats the provider can't yet process are still counted."|t('ai-alt-text')|raw }}</p>

{# Scrolls horizontally rather than overflowing the pane at narrower widths. tabindex/role make
   the scrollable region reachable by keyboard, per WCAG 2.1.1. #}
<div style="overflow-x: auto;" tabindex="0" role="region" aria-label="{{ 'Alt text coverage by site'|t('ai-alt-text') }}">
<table class="data fullwidth">
    <thead>
        <tr>
            <th>{{ "Site"|t('ai-alt-text') }}</th>
            <th>{{ "Image assets"|t('ai-alt-text') }}</th>
            <th>{{ "Alt text"|t('ai-alt-text') }}</th>
            <th>{{ "Coverage"|t('ai-alt-text') }}</th>
            <th>{{ "Actions"|t('ai-alt-text') }}</th>
        </tr>
    </thead>
    <tbody>
        <tr class="totalcount">
            <td><strong>{% if sites|length > 1 %} {{ "All sites"|t('ai-alt-text') }} {% else %} {{ (sites|first).name }} {% endif %}</strong></td>
            <td>{{ totalAssetsWithAltTextForAllSites + totalAssetsWithoutAltTextForAllSites + totalExcludedForAllSites }}</td>
            <td>{{ _self.altTextBar(totalAssetsWithAltTextForAllSites, totalAssetsWithoutAltTextForAllSites, totalExcludedForAllSites) }}</td>
            <td>{{ _self.coverageRing(coverageForAllSites) }}</td>
            <td>
                <div class="buttons">
                    <form method="post" accept-charset="UTF-8">
                        {{ csrfInput() }}
                        {{ actionInput('ai-alt-text/generate/generate-all-assets') }}
                        <button type="submit" class="btn small submit">{{ "Generate all"|t('ai-alt-text') }}</button>
                    </form>
                    <form method="post" accept-charset="UTF-8">
                        {{ csrfInput() }}
                        {{ actionInput('ai-alt-text/generate/generate-assets-without-alt-text') }}
                        <button type="submit" class="btn small submit">{{ "Generate missing"|t('ai-alt-text') }}</button>
                    </form>
                </div>
            </td>
        </tr>
        {% if sites|length > 1 %}
            {% for site in sites %}
            <tr>
                <td>{{ site.name }}</td>
                <td>{{ siteAltTextCounts[site.id].total }}</td>
                <td>{{ _self.altTextBar(siteAltTextCounts[site.id].with, siteAltTextCounts[site.id].without, siteAltTextCounts[site.id].excluded) }}</td>
                <td>{{ _self.coverageRing(siteAltTextCounts[site.id].coverage) }}</td>
                <td>
                    <div class="buttons">
                        <form method="post" accept-charset="UTF-8">
                            {{ csrfInput() }}
                            {{ actionInput('ai-alt-text/generate/generate-all-assets') }}
                            {{ hiddenInput('siteId', site.id) }}
                            <button type="submit" class="btn small submit">{{ "Generate all"|t('ai-alt-text') }}</button>
                        </form>
                        <form method="post" accept-charset="UTF-8">
                            {{ csrfInput() }}
                            {{ actionInput('ai-alt-text/generate/generate-assets-without-alt-text') }}
                            {{ hiddenInput('siteId', site.id) }}
                            <button type="submit" class="btn small submit">{{ "Generate missing"|t('ai-alt-text') }}</button>
                        </form>
                    </div>
                </td>
            </tr>
            {% endfor %}
        {% endif %}
    </tbody>
</table>
</div>
